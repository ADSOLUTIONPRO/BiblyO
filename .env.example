# biblyO : variables du projet Container Manager. Copier ce fichier en « .env » dans le dossier du projet.
# AUCUNE de ces valeurs n'est un secret, et biblyO n'en demande aucun :
#   - les jetons de session sont tirés au hasard et seule leur empreinte est gardée en base ;
#   - le jeton d'installation est produit à la demande dans le conteneur (biblyo install token), à usage unique ;
#   - le mot de passe du premier administrateur se choisit dans le navigateur, sur la page /installation.
# Ne mettez jamais de mot de passe dans ce fichier.

# Port du NAS par lequel on joindra biblyO. À choisir parmi les ports constatés libres (voir INSTALLATION-SYNOLOGY.md).
BIBLYO_PORT=

# Dossier biblyO créé dans File Station (il contiendra data/ et sauvegardes/). Exemple : /volume1/docker/biblyo
BIBLYO_DOSSIER=/volume1/docker/biblyo

# Adresse complète par laquelle on ouvre biblyO. Au début : http://<adresse-locale-du-nas>:<port>
# Après la mise en place du proxy inversé HTTPS : https://<nom-choisi> (les cookies deviennent alors sécurisés).
BIBLYO_BASE_URL=

# Seulement derrière le proxy inversé de DSM : adresse(s) du proxy, séparées par des virgules. Vide sinon.
BIBLYO_TRUSTED_PROXIES=

# Fuseau horaire et niveau de journal.
TZ=Europe/Paris
BIBLYO_LOG_LEVEL=INFO
